const request = require('supertest');
const app = require('../src/index');
const jwt = require('jsonwebtoken');

// Mock sequelize models
jest.mock('../src/models', () => ({
  sequelize: {
    sync: jest.fn().mockResolvedValue(true)
  },
  User: {
    findOne: jest.fn(),
    findByPk: jest.fn(),
    create: jest.fn(),
    destroy: jest.fn()
  },
  Playlist: {
    destroy: jest.fn(),
    findAll: jest.fn(),
    create: jest.fn(),
    findByPk: jest.fn()
  },
  PlaylistSong: {
    destroy: jest.fn(),
    findAll: jest.fn(),
    create: jest.fn()
  },
  Favorite: {
    destroy: jest.fn(),
    findAll: jest.fn(),
    create: jest.fn()
  },
  Song: {
    findAll: jest.fn(),
    findOne: jest.fn(),
    create: jest.fn()
  },
  SearchHistory: {
    create: jest.fn()
  }
}));

// Mock external APIs
jest.mock('../src/utils/externalApis', () => ({
  initializeSpotify: jest.fn().mockResolvedValue(true),
  searchMusic: jest.fn().mockResolvedValue([
    {
      spotifyId: '123',
      spotifyUri: 'spotify:track:123',
      title: 'Test Song',
      artists: ['Test Artist'],
      album: 'Test Album',
      imageUrl: 'https://example.com/image.jpg'
    }
  ])
}));

describe('Music Routes', () => {
  beforeEach(() => {
    jest.clearAllMocks();
    process.env.JWT_SECRET = 'test-secret-key';
  });

  describe('GET /api/music/search', () => {
    it('should search music successfully', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      const { searchMusic } = require('../src/utils/externalApis');

      const response = await request(app)
        .get('/api/music/search')
        .query({ q: 'test' })
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
    });
  });
});

describe('Playlist Routes', () => {
  const { Playlist, PlaylistSong } = require('../src/models');
  const mockPlaylist = {
    id: 1,
    userId: 1,
    name: 'My Playlist',
    description: 'Test Playlist',
    save: jest.fn().mockResolvedValue(true),
    destroy: jest.fn().mockResolvedValue(true)
  };

  beforeEach(() => {
    jest.clearAllMocks();
    process.env.JWT_SECRET = 'test-secret-key';
  });

  describe('POST /api/playlists', () => {
    it('should create a new playlist', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.create.mockResolvedValue(mockPlaylist);

      const response = await request(app)
        .post('/api/playlists')
        .set('Authorization', `Bearer ${token}`)
        .send({
          name: 'My Playlist',
          description: 'Test Playlist'
        });

      expect(response.status).toBe(201);
      expect(response.body.data).toBeDefined();
    });
  });

  describe('GET /api/playlists', () => {
    it('should get user playlists', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.findAll.mockResolvedValue([mockPlaylist]);

      const response = await request(app)
        .get('/api/playlists')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
      expect(Array.isArray(response.body.data)).toBe(true);
    });
  });

  describe('GET /api/playlists/:id', () => {
    it('should get playlist by id', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.findByPk.mockResolvedValue(mockPlaylist);

      const response = await request(app)
        .get('/api/playlists/1')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
    });
  });

  describe('PUT /api/playlists/:id', () => {
    it('should update playlist', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.findByPk.mockResolvedValue(mockPlaylist);

      const response = await request(app)
        .put('/api/playlists/1')
        .set('Authorization', `Bearer ${token}`)
        .send({
          name: 'Updated Playlist'
        });

      expect(response.status).toBe(200);
    });
  });

  describe('DELETE /api/playlists/:id', () => {
    it('should delete playlist', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.findByPk.mockResolvedValue(mockPlaylist);

      const response = await request(app)
        .delete('/api/playlists/1')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
    });
  });

  describe('POST /api/playlists/:id/songs', () => {
    it('should add song to playlist', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Playlist.findByPk.mockResolvedValue(mockPlaylist);
      PlaylistSong.create.mockResolvedValue({ playlistId: 1, songId: 1 });

      const response = await request(app)
        .post('/api/playlists/1/songs')
        .set('Authorization', `Bearer ${token}`)
        .send({
          songId: 1
        });

      expect(response.status).toBe(201);
    });
  });
});

describe('Favorites Routes', () => {
  const { Favorite } = require('../src/models');
  const mockFavorite = {
    id: 1,
    userId: 1,
    songId: 1,
    save: jest.fn().mockResolvedValue(true),
    destroy: jest.fn().mockResolvedValue(true)
  };

  beforeEach(() => {
    jest.clearAllMocks();
    process.env.JWT_SECRET = 'test-secret-key';
  });

  describe('POST /api/favorites', () => {
    it('should add song to favorites', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Favorite.create.mockResolvedValue(mockFavorite);

      const response = await request(app)
        .post('/api/favorites')
        .set('Authorization', `Bearer ${token}`)
        .send({
          songId: 1
        });

      expect(response.status).toBe(201);
    });
  });

  describe('GET /api/favorites', () => {
    it('should get user favorites', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Favorite.findAll.mockResolvedValue([mockFavorite]);

      const response = await request(app)
        .get('/api/favorites')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
    });
  });

  describe('DELETE /api/favorites/:id', () => {
    it('should remove favorite', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      Favorite.findByPk = jest.fn().mockResolvedValue(mockFavorite);

      const response = await request(app)
        .delete('/api/favorites/1')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
    });
  });
});

describe('Protected Routes', () => {
  beforeEach(() => {
    jest.clearAllMocks();
    process.env.JWT_SECRET = 'test-secret-key';
  });

  it('should return 401 for protected routes without token', async () => {
    const response = await request(app)
      .get('/api/playlists');

    expect(response.status).toBe(401);
  });

  it('should return 401 for invalid token', async () => {
    const response = await request(app)
      .get('/api/playlists')
      .set('Authorization', 'Bearer invalid-token');

    expect(response.status).toBe(401);
  });
});
