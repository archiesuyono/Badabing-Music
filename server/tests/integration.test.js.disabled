const request = require('supertest');
const app = require('../src/index');
const { User, Playlist, Favorite } = require('../src/models');
const { hashPassword } = require('../src/utils/authUtils');
const jwt = require('jsonwebtoken');

// Mock sequelize models
jest.mock('../src/models', () => ({
  sequelize: {
    sync: jest.fn().mockResolvedValue(true)
  },
  User: {
    findOne: jest.fn(),
    findByPk: jest.fn(),
    create: jest.fn(),
    destroy: jest.fn()
  },
  Playlist: {
    destroy: jest.fn(),
    findAll: jest.fn(),
    create: jest.fn()
  },
  Favorite: {
    destroy: jest.fn(),
    findAll: jest.fn()
  }
}));

// Mock external APIs
jest.mock('../src/utils/externalApis', () => ({
  initializeSpotify: jest.fn().mockResolvedValue(true),
  searchMusic: jest.fn().mockResolvedValue([
    {
      spotifyId: '123',
      title: 'Test Song',
      artists: ['Test Artist'],
      album: 'Test Album'
    }
  ])
}));

describe('Authentication and User Routes Integration', () => {
  const testUser = {
    id: 1,
    email: 'test@example.com',
    username: 'testuser',
    password: 'hashedPassword123',
    firstName: 'Test',
    lastName: 'User',
    profileImage: null,
    save: jest.fn().mockResolvedValue(true),
    destroy: jest.fn().mockResolvedValue(true)
  };

  beforeEach(() => {
    jest.clearAllMocks();
    process.env.JWT_SECRET = 'test-secret-key';
    process.env.GOOGLE_CLIENT_ID = 'test-google-id';
  });

  describe('User Registration Flow', () => {
    it('should register user with all fields', async () => {
      User.findOne
        .mockResolvedValueOnce(null)
        .mockResolvedValueOnce(null);
      User.create.mockResolvedValue(testUser);

      const response = await request(app)
        .post('/api/auth/register')
        .send({
          email: 'newuser@example.com',
          username: 'newuser',
          password: 'Password123!',
          firstName: 'John',
          lastName: 'Doe'
        });

      expect(response.status).toBe(201);
      expect(response.body.data.token).toBeDefined();
      expect(response.body.data.user.firstName).toBe('Test');
    });

    it('should handle user creation with minimal fields', async () => {
      User.findOne
        .mockResolvedValueOnce(null)
        .mockResolvedValueOnce(null);
      User.create.mockResolvedValue(testUser);

      const response = await request(app)
        .post('/api/auth/register')
        .send({
          email: 'newuser@example.com',
          username: 'newuser',
          password: 'Password123!'
        });

      expect(response.status).toBe(201);
      expect(response.body.data.user).toBeDefined();
    });
  });

  describe('User Login Flow', () => {
    it('should successfully login with correct credentials', async () => {
      const hashedPassword = await hashPassword('Password123!');
      User.findOne.mockResolvedValue({
        ...testUser,
        password: hashedPassword
      });

      const response = await request(app)
        .post('/api/auth/login')
        .send({
          email: 'test@example.com',
          password: 'Password123!'
        });

      expect(response.status).toBe(200);
      expect(response.body.data.token).toBeDefined();
      expect(response.body.data.user.username).toBe('testuser');
    });

    it('should reject login with invalid credentials', async () => {
      User.findOne.mockResolvedValue(testUser);

      const response = await request(app)
        .post('/api/auth/login')
        .send({
          email: 'test@example.com',
          password: 'wrongpassword'
        });

      expect(response.status).toBe(401);
    });
  });

  describe('User Profile Management', () => {
    it('should get current user profile', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      User.findByPk.mockResolvedValue(testUser);

      const response = await request(app)
        .get('/api/auth/me')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
      expect(response.body.data.email).toBe(testUser.email);
    });

    it('should update user profile', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      const updatedUser = { ...testUser, firstName: 'Updated' };
      User.findByPk.mockResolvedValue(updatedUser);

      const response = await request(app)
        .put('/api/auth/profile')
        .set('Authorization', `Bearer ${token}`)
        .send({
          firstName: 'Updated',
          lastName: 'User'
        });

      expect(response.status).toBe(200);
      expect(response.body.data.firstName).toBe('Updated');
    });

    it('should delete user account', async () => {
      const token = jwt.sign({ userId: 1 }, process.env.JWT_SECRET);
      User.findByPk.mockResolvedValue(testUser);
      Playlist.destroy.mockResolvedValue(2);
      Favorite.destroy.mockResolvedValue(5);

      const response = await request(app)
        .delete('/api/auth/account')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
      expect(response.body.message).toContain('Account deleted successfully');
    });
  });

  describe('Authentication Error Handling', () => {
    it('should return 401 when accessing protected route without token', async () => {
      const response = await request(app)
        .get('/api/auth/me');

      expect(response.status).toBe(401);
    });

    it('should return 401 when token is missing from protected route', async () => {
      const response = await request(app)
        .get('/api/auth/me')
        .set('Authorization', 'Bearer');

      expect(response.status).toBe(401);
    });
  });
});
